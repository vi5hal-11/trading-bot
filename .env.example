# ── Binance USDT-M Futures ────────────────────────────────────────────────────
# Get keys at: https://www.binance.com/en/my/settings/api-management
# Enable Demo Trading at: Binance Futures → top-right menu → Demo Trading
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true          # true = Demo Trading (fake money) | false = live

# ── Paper trading (internal simulation, no exchange connection) ───────────────
PAPER_TRADING=false           # set true to bypass exchange entirely
PAPER_INITIAL_BALANCE=10000.0

# ── Database ──────────────────────────────────────────────────────────────────
# In Docker: bot service overrides DATABASE_URL automatically using DB_USER/DB_PASSWORD
# For local dev, set full URL manually
DB_USER=bot_user
DB_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://bot_user:change_me_strong_password@localhost:5433/trading_bot

# ── Redis ─────────────────────────────────────────────────────────────────────
# In Docker: bot service overrides REDIS_URL automatically
# For local dev only:
REDIS_URL=redis://localhost:6379/0

# ── Telegram alerts + command bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Sentiment data (optional) ────────────────────────────────────────────────
CRYPTOPANIC_API_KEY=

# ── Dashboard authentication ─────────────────────────────────────────────────
DASHBOARD_PASSWORD=change_me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_a_64_char_hex_string_here

# ── Grafana monitoring (optional) ────────────────────────────────────────────
GRAFANA_PASSWORD=change_me
